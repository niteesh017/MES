@model IEnumerable<RadialGraderMES.Models.Machine>
@{
    ViewData["Title"] = "Machines";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Machines</h2>

        <a asp-action="Create"
        class="btn btn-primary">
            +Add machine
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Machine Code</th>
                <th>Machine Name</th>
                <th>Machine Status</th>
                <th>Machine Active</th>
                <th>Created At</th>
            </tr>
        </thead>
        
        <tbody>
            @foreach(var machine in Model)
            {
                <tr>
                    <td>
                        @machine.MachineCode
                    </td>

                    <td>
                        @machine.MachineName
                    </td>

                    <td>
                        @machine.Status
                    </td>

                    <td>
                        @(machine.IsActive? "Yes" : "No")
                    </td>

                    <td>
                        @machine.CreatedAt.ToLocalTime()
                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>