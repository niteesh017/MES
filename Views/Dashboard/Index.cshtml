                        </div>

                    </div>


                    <div class="grade-trend-section"
                         style="flex:1;
                        min-width:0;
                        height:180px;
                        position:relative;">

                        <div style="height:180px;
                            width:100%;
                            position:relative;">

                            <canvas id="gradeTrendChart"></canvas>

