                                    Grade 1
                                </span>

                                <span id="grade1Legend">
                                    0.00 KG (0.0%)
                                </span>

                            </div>

                        </div>


                        <div class="grade-legend-item">

                            <span class="grade-dot grade-2"></span>

                            <div class="grade-info">

                                <span class="grade-title">
                                    Grade 2
                                </span>

                                <span id="grade2Legend">
                                    0.00 KG (0.0%)
                                </span>

                            </div>

                        </div>


                        <div class="grade-legend-item">

                            <span class="grade-dot grade-3"></span>

                            <div class="grade-info">

                                <span class="grade-title">
                                    Grade 3
                                </span>

                                <span id="grade3Legend">
                                    0.00 KG (0.0%)
                                </span>

                            </div>

                        </div>


                        <div class="grade-legend-item">

                            <span class="grade-dot grade-4"></span>

                            <div class="grade-info">

                                <span class="grade-title">
                                    Grade 4 / Rejected
                                </span>

                                <span id="grade4Legend">
                                    0.00 KG (0.0%)
