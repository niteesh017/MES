@model IEnumerable<RadialGraderMES.Models.Machine>

@{
    ViewData["Title"] = "Machines";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1 fw-bold">Machines</h2>

            <div class="text-muted small">
                Manage and monitor registered production machines
            </div>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">
            + Add Machine
        </a>

    </div>


    <!-- Machine Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Card Header -->
        <div class="px-4 py-3 border-bottom bg-light">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Machine List
                </h5>

                <div class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                    @(Model?.Count() ?? 0) Machines
                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Machine Code</th>
                        <th class="py-3">Machine Name</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 active-column">Active</th>
                        <th class="py-3 created-column">Created At</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var machine in Model)
                        {
                            <tr>

                                <!-- Machine Code -->
                                <td class="px-4">
                                    <span class="fw-semibold">
                                        @machine.MachineCode
                                    </span>
                                </td>


                                <!-- Machine Name -->
                                <td>
                                    <span class="fw-semibold">
                                        @machine.MachineName
                                    </span>
                                </td>


                                <!-- Status -->
                                <td>

                                    @{
                                        var status = machine.Status?.ToString()?.ToLower();
                                    }

                                    @if (status == "running" || status == "online")
                                    {
                                        <span class="status-badge status-running">
                                            <span class="status-dot"></span>
                                            @machine.Status
                                        </span>
                                    }
                                    else if (status == "stopped" || status == "offline")
                                    {
                                        <span class="status-badge status-stopped">
                                            <span class="status-dot"></span>
                                            @machine.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-idle">
                                            <span class="status-dot"></span>
                                            @(machine.Status ?? "Unknown")
                                        </span>
                                    }

                                </td>


                                <!-- Active -->
                                <td class="active-column">

                                    @if (machine.IsActive)
                                    {
                                        <span class="active-badge active-yes">
                                            ● Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="active-badge active-no">
                                            ● Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Created -->
                                <td class="created-column">
                                    @machine.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">

                                <h6 class="fw-semibold mb-1">
                                    No machines found
                                </h6>

                                <p class="text-muted small mb-3">
                                    Add your first production machine to get started.
                                </p>

                                <a asp-action="Create"
                                   class="btn btn-primary rounded-3 px-4">
                                    + Add Machine
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<style>

    /* Status */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-running {
        background: rgba(25, 135, 84, 0.10);
        color: #198754;
    }

        .status-running .status-dot {
            background: #198754;
        }

    .status-stopped {
        background: rgba(220, 53, 69, 0.10);
        color: #dc3545;
    }

        .status-stopped .status-dot {
            background: #dc3545;
        }

    .status-idle {
        background: rgba(255, 193, 7, 0.14);
        color: #997404;
    }

        .status-idle .status-dot {
            background: #ffc107;
        }


    /* Active */

    .active-badge {
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .active-yes {
        color: #198754;
    }

    .active-no {
        color: #6c757d;
    }


    /* Column Spacing */

    .active-column {
        width: 120px;
        min-width: 120px;
        white-space: nowrap;
    }

    .created-column {
        width: 190px;
        min-width: 190px;
        white-space: nowrap;
        text-align: left;
    }


    /* Table */

    .table {
        margin-bottom: 0;
        table-layout: auto;
    }

        .table > :not(caption) > * > * {
            border-bottom-color: #edf0f2;
        }

        .table thead th {
            font-size: 13px;
            font-weight: 600;
            color: #495057;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 14px;
        }

        .table tbody tr {
            transition: background-color 0.15s ease;
        }

            .table tbody tr:hover {
                background-color: rgba(13, 110, 253, 0.025);
            }


    /* Card */

    .card {
        background: #fff;
    }


    /* Mobile */

    @@media (max-width: 768px) {

        .container-fluid {
            padding-left: 15px !important;
            padding-right: 15px !important;
        }

        .d-flex.justify-content-between {
            gap: 15px;
        }

        .created-column {
            width: 190px;
            min-width: 190px;
        }
    }

</style>

