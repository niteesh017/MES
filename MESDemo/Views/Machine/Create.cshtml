@model RadialGraderMES.Models.Machine

@{
    ViewData["Title"] = "Add Machine";
}

<div class="machine-page">

    <!-- === PAGE HEADER === -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-2">
            <div class="page-icon">
                <i class="bi bi-cpu"></i>
            </div>

            <div>
                <h4 class="page-title mb-0">Add Machine</h4>
                <p class="page-subtitle mb-0">
                    Register a new machine in the MES system.
                </p>
            </div>
        </div>

        <a asp-controller="Machine"
           asp-action="Index"
           class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>


    <!-- === MACHINE FORM === -->
    <div class="section-card">

        <div class="section-header">
            <div class="section-title-wrap">

                <div class="section-icon">
                    <i class="bi bi-sliders"></i>
                </div>

                <div>
                    <div class="section-title">
                        Machine Information
                    </div>

                    <div class="section-subtitle">
                        Enter machine details to register it.
                    </div>
                </div>

            </div>
        </div>


        <div class="section-body">

            <form asp-controller="Machine"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- === MACHINE CODE === -->
                    <div class="col-md-6">

                        <label asp-for="MachineCode"
                               class="form-label">
                            Machine Code
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-upc-scan"></i>
                            </span>

                            <input asp-for="MachineCode"
                                   class="form-control"
                                   placeholder="Enter machine code" />

                        </div>

                        <span asp-validation-for="MachineCode"
                              class="text-danger small"></span>

                    </div>


                    <!-- === MACHINE NAME === -->
                    <div class="col-md-6">

                        <label asp-for="MachineName"
                               class="form-label">
                            Machine Name
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-gear"></i>
                            </span>

                            <input asp-for="MachineName"
                                   class="form-control"
                                   placeholder="Enter machine name" />

                        </div>

                        <span asp-validation-for="MachineName"
                              class="text-danger small"></span>

                    </div>

                </div>


                <!-- === ACTIONS === -->
                <div class="form-actions">

                    <a asp-controller="Machine"
                       asp-action="Index"
                       class="btn btn-light border px-4">
                        <i class="bi bi-x-lg me-1"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        Save Machine
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>


<style>
    body {
        background: #f5f6f8;
    }

    .machine-page {
        min-height: calc(100vh - 60px);
        padding: 22px 24px;
    }

    /* === HEADER === */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .page-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4ff;
        color: #0d6efd;
        border-radius: 9px;
        font-size: 17px;
    }

    .page-title {
        color: #1f2937;
        font-size: 20px;
        font-weight: 700;
    }

    .page-subtitle {
        margin-top: 3px;
        color: #64748b;
        font-size: 12px;
    }

    /* === CARD === */

    .section-card {
        background: #fff;
        border: 1px solid #e3e7ec;
        border-radius: 11px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
        overflow: hidden;
    }

    .section-header {
        padding: 18px 22px;
        background: #f8fafc;
        border-bottom: 1px solid #e9edf2;
    }

    .section-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4ff;
        color: #0d6efd;
        border-radius: 7px;
        font-size: 14px;
    }

    .section-title {
        color: #1f2937;
        font-size: 15px;
        font-weight: 700;
    }

    .section-subtitle {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    .section-body {
        padding: 25px 22px;
    }

    /* === FORM === */

    .form-label {
        margin-bottom: 7px;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control {
        min-height: 43px;
        border-color: #dce2e8;
        border-radius: 7px;
        font-size: 13px;
    }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .15rem rgba(13, 110, 253, .1);
        }

    .input-group-text {
        min-width: 43px;
        justify-content: center;
        background: #f8fafc;
        border-color: #dce2e8;
        color: #64748b;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #eef2f7;
    }

    .btn {
        min-height: 40px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    /* === RESPONSIVE === */

    @@media (max-width: 768px) {
        .machine-page {
            padding: 16px 12px;
        }

        .page-header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .section-body {
            padding: 20px 16px;
        }
    }
</style>