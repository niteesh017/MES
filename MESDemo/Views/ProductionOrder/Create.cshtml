@model RadialGraderMES.Models.ProductionOrder

@{
    ViewData["Title"] = "Create Production Order";
}

<div class="container mt-4">
    <h2>Create Production Order</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="OrderNumber" class="form-label">
                Order Number
            </label>

            <input asp-for="OrderNumber"
            class="form-control"
            placeholder="ORD-2026-001"/>

            <span asp-validation-for="OrderNumber" 
            class="text-danger">           
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">
                Product
            </label>

            <input asp-for="ProductName"
            class="form-control"
            placeholder="Potato"/>        
        </div>

        <div class="mb-3">
            <label asp-for="TargetQuantity"
            class="form-label">
            Target Quantity
            </label>

            <input asp-for="TargetQuantity"
            type="number"
            step="0.001"
            class="form-control"
            />
        </div>

        <div class="mb-3">
            <label asp-for="Unit" class="form-label">
                Unit
            </label>

            <select asp-for="Unit" class="form-select">
                <option value="KG">KG</option>
                <option value="TON">TOn</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="MachineId" class="form-label">
                Machine
            </label>

            <select asp-for="MachineId"
                    asp-items="ViewBag.Machines"
                    class="form-select">

                <option value="">Select Machine</option>

            </select>

            <span asp-validation-for="MachineId"
                  class="text-danger"></span>
        </div>
        
        <button type="submit"
            class="btn btn-primary">
            Create Order
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>    

    </form>

</div>